{
  "name": "k-hiphop-map",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:check": "node scripts/check-visitor-api.mjs",
    "data:collect": "python3 scripts/collect.py",
    "data:build": "tsx scripts/build-snapshot.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts tests/trailer.e2e.spec.ts tests/visitor-counter.e2e.spec.ts",
    "trailer:render": "node scripts/trailer/prepare-assets.mjs && python3 scripts/trailer/beat.py && node scripts/trailer/capture.mjs && node scripts/trailer/render.mjs",
    "test:performance": "playwright test tests/performance.spec.ts --grep '1000 artists'",
    "data:validate:launch": "tsx scripts/validate-data.ts --launch",
    "prebuild": "npm run data:build && npm run data:validate:launch"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "@sigma/node-image": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
